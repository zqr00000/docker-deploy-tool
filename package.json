{
  "name": "docker-deploy-tool",
  "version": "1.0.0",
  "description": "Docker Deploy Tool - 现代化的 Docker 部署管理工具",
  "main": "dist/main/index.js",
  "author": "Docker Deploy Tool Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "preview": "electron-vite preview",
    "package": "electron-builder --win --config",
    "package:dir": "electron-builder --win dir --config",
    "package:nsis": "electron-builder --win nsis --config",
    "package:msi": "electron-builder --win msi --config",
    "release": "npm run clean && npm run build && electron-builder --win nsis --config -p always"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/azure": "^4.0.41",
    "@ai-sdk/google": "^4.0.42",
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@mastra/core": "^1.58.0",
    "@mastra/memory": "^1.26.1",
    "ai": "^7.0.62",
    "better-sqlite3": "^11.3.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.9",
    "node-cron": "^3.0.3",
    "ssh2": "^1.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.1",
    "@electron/rebuild": "^3.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.1",
    "antd": "^5.21.0",
    "dayjs": "^1.11.21",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "i18next": "^23.15.1",
    "js-yaml": "^4.3.2",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.7",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.yunduo.app",
    "productName": "YunDuo",
    "directories": {
      "output": "release"
    },
    "publish": {
        "provider": "github",
        "owner": "zqr00000",
        "repo": "docker-deploy-tool"
      },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/",
        "to": "build/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "YunDuo-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "differentialPackage": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YunDuo",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
