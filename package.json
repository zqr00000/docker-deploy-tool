{
  "name": "docker-deploy-tool",
  "version": "1.0.0",
  "description": "Docker Deploy Tool - 现代化的 Docker 部署管理工具",
  "main": "dist/main/index.js",
  "author": "Docker Deploy Tool Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --win --config",
    "package:dir": "electron-builder --win dir --config",
    "package:nsis": "electron-builder --win nsis --config",
    "package:msi": "electron-builder --win msi --config"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@monaco-editor/react": "^4.7.0",
    "antd": "^5.21.0",
    "better-sqlite3": "^11.3.0",
    "dayjs": "^1.11.21",
    "electron-log": "^5.2.0",
    "i18next": "^23.15.1",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4",
    "ssh2": "^1.15.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.7"
  },
  "build": {
    "appId": "com.dockerdeploytool.app",
    "productName": "Docker Deploy Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/",
        "to": "build/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.svg",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Docker Deploy Tool",
      "installerIcon": "build/icon.svg",
      "uninstallerIcon": "build/icon.svg"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
